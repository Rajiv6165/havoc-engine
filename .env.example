# ==========================================
# Havoc Engine Environment Variables Example
# ==========================================

# Bind address for HTTP API (defaults to 127.0.0.1; set to 0.0.0.0 in Docker)
HAVOC_BIND_ADDRESS=127.0.0.1

# Optional shared bearer token for API authentication (POST /api/experiments)
HAVOC_API_TOKEN=your-shared-secret-token-here

# Prometheus server base URL (host port is 9092 locally, 9090 in Docker compose)
PROMETHEUS_URL=http://localhost:9092

# PostgreSQL database connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/havoc?sslmode=disable

# Anthropic Claude API Key for AI postmortem report generation
ANTHROPIC_API_KEY=

# Internal engine API URL used by the Next.js dashboard server-side proxy
HAVOC_API_URL=http://localhost:8080
